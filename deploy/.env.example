# Copy to ".env" ON THE SERVER ONLY and fill in. Never commit the real .env.
# (The real values are the same ones you use in IntelliJ's run configurations,
#  except JWT_SECRET, which should be a NEW one for the server.)

DOMAIN=etoile-stars.duckdns.org

DB_URL=
DB_USER=
DB_PASSWORD=

# A fresh long random value, so old test logins stop working
JWT_SECRET=

# Filled in by a command on the server (base64 of the Firebase key file)
FIREBASE_CREDENTIALS=
