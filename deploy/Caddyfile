# Front door: https for {$DOMAIN} (e.g. etoile-stars.duckdns.org),
# sends each request to the right service by its path.
{$DOMAIN} {
	encode gzip

	# Never public: both accounts already exist, and /api/events is
	# only for dates-service -> notification-service inside the server.
	@private path /api/auth/signup /api/events /api/events/*
	@auth path /api/auth/*
	@dates path /api/dates /api/dates/* /api/me
	@notifications path /api/love /api/love/* /api/devices /api/devices/* /api/notifications/*

	# "route" keeps these rules in exactly this order (block first, then forward)
	route {
		respond @private 404
		reverse_proxy @auth auth:8081
		reverse_proxy @dates dates:8082
		reverse_proxy @notifications notifications:8083
		respond 404
	}
}
